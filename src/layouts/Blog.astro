---
import "@styles/reset.css";
import "@styles/vars.css";
import "@styles/globals.css";
import "@styles/animations.css";

import { ClientRouter } from "astro:transitions";
import UmamiTracker from "@components/analytics/UmamiTracker.astro";
import Footer from "@components/layout/Footer.astro";
import StickyHeader from "@components/layout/StickyHeader.astro";
import ThemeScript from "@components/ThemeScript.astro";
import { getFeedUrl, type LocaleUrlMap } from "@ts/i18n";

interface Props {
	title: string;
	description: string;
	image: string;
	url: string;
	noIndex?: boolean;
	lang?: "en" | "es";
	schema?: Record<string, unknown> | Record<string, unknown>[];
	alternates?: Partial<Record<"en" | "es" | "x-default", string>>;
	languageSwitcher?: LocaleUrlMap;
}

const {
	title,
	description,
	image,
	url,
	noIndex,
	lang = "en",
	schema,
	alternates,
	languageSwitcher,
} = Astro.props;

const structuredData = schema
	? Array.isArray(schema)
		? schema
		: [schema]
	: [];

const ogLocale = lang === "es" ? "es_MX" : "en_US";
const hreflangAlternates = {
	[lang]: url,
	"x-default": url,
	...(alternates ?? {}),
};
const feedHref = getFeedUrl(lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Satoshi-Variable.woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>
      {`${title} - Santiago Carrasco (Santychuy)`}
    </title>
    <link rel="canonical" href={url} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Santychuy Blog RSS"
      href={feedHref}
    />
    <link rel="alternate" type="text/plain" title="LLMs Manifest" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLMs Full Index" href="/llms-full.txt" />
    {hreflangAlternates.en && <link rel="alternate" hreflang="en" href={hreflangAlternates.en} />}
    {hreflangAlternates.es && <link rel="alternate" hreflang="es" href={hreflangAlternates.es} />}
    {hreflangAlternates["x-default"] && (
      <link rel="alternate" hreflang="x-default" href={hreflangAlternates["x-default"]} />
    )}
    {noIndex && <meta name="robots" content="noindex" />}
    <ClientRouter />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} - Santiago Carrasco (Santychuy)`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Santiago Carrasco (Santychuy)" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@santychuy" />
    <meta name="twitter:creator" content="@santychuy" />
    <meta name="twitter:title" content={`${title} - Santiago Carrasco (Santychuy)`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {structuredData.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <UmamiTracker />
  </head>
  <body class="min-h-svh">
    <StickyHeader lang={lang} languageSwitcher={languageSwitcher} />
    <main>
      <slot />
    </main>
    <div class="blog-footer-shell">
      <Footer lang={lang} />
    </div>
  </body>
</html>

<style>
  .blog-footer-shell :global(footer) {
    @media (width < 68.75rem) {
      width: 100%;
      padding-inline: var(--layout-gutter-mobile);
      padding-block: var(--space-5);
    }

    @media (width >= 34.375rem) and (width < 68.75rem) {
      padding-inline: var(--layout-gutter-tablet);
    }
  }
</style>
