---
import { rankedModels, validateRankings } from "../../../data/ai-models";
import usageJson from "../../../data/model-usage.json";
import { getLocaleMessages } from "../../../i18n";
import {
	type ModelUsageData,
	summarizeUsage,
	unrankedUsage,
} from "../../../ts/ai-model-usage";
import { getLocalizedPath, type Locale } from "../../../ts/i18n";

const { lang } = Astro.props as { lang: Locale };
const messages = getLocaleMessages(lang).aiModels;
const usage = usageJson as ModelUsageData;
const integer = new Intl.NumberFormat(lang);
const calendarDate = new Intl.DateTimeFormat(lang, {
	dateStyle: "medium",
	timeZone: usage.timezone,
});
const formatDate = (value?: string) =>
	value
		? calendarDate.format(
				new Date(value.includes("T") ? value : `${value}T12:00:00Z`),
			)
		: messages.unavailable;
validateRankings();
const ownedKeys = new Set(rankedModels.flatMap(({ usageKeys }) => usageKeys));
const unranked = unrankedUsage(usage.daily, ownedKeys);
const collapseUnranked = unranked.length > 8;
---

<div class="ai-models">
	<header class="introduction">
		<h1>{messages.title}</h1>
		<p class="lede">{messages.intro}</p>
		<p class="generated">
			{messages.generated}: <time datetime={usage.generatedAt}>{formatDate(usage.generatedAt)}</time>
		</p>
	</header>

	<section class="page-section" aria-labelledby="ranked-models-heading">
		<div class="section-heading">
			<h2 id="ranked-models-heading">{messages.ranked}</h2>
			<p>{messages.rankedIntro}</p>
		</div>
		{
			rankedModels.length > 0 ? (
				<ol class="ranked-list">
					{rankedModels.map((model, index) => {
						const summary = summarizeUsage(usage.daily, model.usageKeys);
						const opinion = model.opinion[lang];
						const href = getLocalizedPath(lang, `ai-models/${model.id}`);
						return (
							<li class="model-row">
								{
									index < 3 ? (
										<p class={`rank-number rank-badge rank-badge--${index + 1}`}>
											<span class="rank-badge__number" aria-hidden="true">{index + 1}</span>
											<span class="sr-only">{messages.rank} {index + 1}</span>
										</p>
									) : (
										<p class="rank-number">{messages.rank} {index + 1}</p>
									)
								}
								<h3>{model.name}</h3>
								<div class="model-main">
									<p class="summary">{opinion.summary}</p>
									{opinion.bestFor && <p class="best-for"><strong>{messages.bestFor}</strong> {opinion.bestFor}</p>}
									{summary.rows.length === 0 ? (
										<p class="empty-note">{messages.noEvidence}</p>
									) : (
										<dl class="quick-evidence">
											<div><dt>{messages.activeDays}</dt><dd>{integer.format(summary.activeDays)}</dd></div>
											<div><dt>{messages.events}</dt><dd>{integer.format(summary.usageEvents)}</dd></div>
											<div><dt>{messages.lastObserved}</dt><dd>{formatDate(summary.lastObserved)}</dd></div>
										</dl>
									)}
									<a class="review-link" href={href}>{messages.reviewLink}</a>
								</div>
							</li>
						);
					})}
				</ol>
			) : (
				<p class="empty-state">{messages.emptyRanked}</p>
			)
		}
	</section>

	<section class="page-section" aria-labelledby="unranked-models-heading">
		<div class="section-heading">
			<h2 id="unranked-models-heading">{messages.unranked}</h2>
			<p>{messages.unrankedIntro}</p>
		</div>
		{
			unranked.length > 0 ? (
				<details class="unranked-details" open={!collapseUnranked}>
					{collapseUnranked && <summary>{messages.unrankedCount.replace("{count}", integer.format(unranked.length))}</summary>}
					<div class="unranked-list">
						{unranked.map((summary) => (
							<article class="unranked-row">
								<h3>{summary.model ?? messages.unknownModel}</h3>
								<dl class="quick-evidence">
									<div><dt>{messages.activeDays}</dt><dd>{integer.format(summary.activeDays)}</dd></div>
									<div><dt>{messages.events}</dt><dd>{integer.format(summary.usageEvents)}</dd></div>
								</dl>
							</article>
						))}
					</div>
				</details>
			) : (
				<p class="empty-state">{messages.emptyUnranked}</p>
			)
		}
	</section>

</div>

<style>
	.ai-models { width: 100%; max-width: var(--measure-content-max); margin-inline: auto; }
	.introduction, .section-heading { max-width: var(--measure-section-max); }
	.generated, .section-heading p, .empty-note, dt { color: var(--text-secondary); }
	h1 { margin: 0; font-size: var(--font-size-display); line-height: var(--leading-tight); }
	.lede { margin: var(--space-5) 0 0; font-size: var(--font-size-lg); line-height: var(--leading-copy); }
	.generated { margin: var(--space-4) 0 0; font-size: var(--font-size-sm); }
	.page-section { margin-top: var(--layout-section-gap-mobile); padding-top: var(--space-8); border-top: var(--border-width-default) solid var(--border-subtle); }
	.page-section:first-of-type { border-top: 0; }
	.section-heading h2, .model-row h3, .unranked-row h3 { margin: 0; }
	.model-row h3 { font-size: var(--font-size-display); line-height: var(--leading-tight); }
	.section-heading p { margin: var(--space-3) 0 0; line-height: var(--leading-copy); }
	.ranked-list, .unranked-list { display: grid; gap: var(--space-6); margin: var(--space-8) 0 0; padding: 0; list-style: none; }
	.model-row { display: grid; grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr); column-gap: var(--space-5); padding-top: var(--space-6); border-top: var(--border-width-default) solid var(--border-strong); }
	.model-main { grid-column: 2; }
	.rank-number { align-self: center; margin: 0; color: var(--text-tertiary); font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); font-variant-numeric: tabular-nums; }
	.rank-badge { position: relative; isolation: isolate; display: grid; inline-size: calc(var(--space-10) * 1.1547); block-size: var(--space-10); place-items: center; color: var(--rank-medal-ink); font-size: var(--font-size-base); font-weight: var(--font-weight-semibold); }
	.rank-badge::before, .rank-badge::after { position: absolute; content: ""; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }
	.rank-badge::before { z-index: -2; inset: 0; background: linear-gradient(145deg, var(--rank-badge-highlight), var(--rank-badge-edge) 52%, var(--rank-badge-shadow)); filter: drop-shadow(0 calc(var(--border-width-default) * 2) var(--space-1) color-mix(in oklch, var(--rank-badge-shadow) 42%, transparent)); }
	.rank-badge::after { z-index: -1; inset: calc(var(--border-width-default) * 2); background: radial-gradient(circle at 32% 24%, color-mix(in oklch, var(--neutrals---black--1) 34%, transparent), transparent 42%), linear-gradient(145deg, var(--rank-badge-highlight), var(--rank-badge-color) 48%, var(--rank-badge-shadow)); }
	.rank-badge__number { line-height: 1; text-shadow: 0 var(--border-width-default) 0 color-mix(in oklch, var(--neutrals---black--1) 34%, transparent); }
	.rank-badge--1 { --rank-badge-color: var(--rank-medal-gold); --rank-badge-highlight: color-mix(in oklch, var(--rank-medal-gold), var(--neutrals---black--1) 32%); --rank-badge-edge: color-mix(in oklch, var(--rank-medal-gold), var(--neutrals---black--13) 15%); --rank-badge-shadow: color-mix(in oklch, var(--rank-medal-gold), var(--neutrals---black--13) 30%); }
	.rank-badge--2 { --rank-badge-color: var(--rank-medal-silver); --rank-badge-highlight: color-mix(in oklch, var(--rank-medal-silver), var(--neutrals---black--1) 30%); --rank-badge-edge: color-mix(in oklch, var(--rank-medal-silver), var(--neutrals---black--13) 13%); --rank-badge-shadow: color-mix(in oklch, var(--rank-medal-silver), var(--neutrals---black--13) 28%); }
	.rank-badge--3 { --rank-badge-color: var(--rank-medal-bronze); --rank-badge-highlight: color-mix(in oklch, var(--rank-medal-bronze), var(--neutrals---black--1) 27%); --rank-badge-edge: color-mix(in oklch, var(--rank-medal-bronze), var(--neutrals---black--13) 15%); --rank-badge-shadow: color-mix(in oklch, var(--rank-medal-bronze), var(--neutrals---black--13) 30%); }
	.summary, .best-for { max-width: var(--measure-card-copy-max); margin: var(--space-4) 0 0; line-height: var(--leading-copy); }
	.quick-evidence { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin: var(--space-5) 0 0; }
	.quick-evidence div { display: grid; gap: var(--space-1); }
	dt { font-size: var(--font-size-xs); font-weight: var(--font-weight-medium); }
	dd { margin: 0; font-size: var(--font-size-sm); font-variant-numeric: tabular-nums; font-weight: var(--font-weight-medium); }
	.review-link { display: inline-flex; min-height: var(--touch-target-min); align-items: center; margin-top: var(--space-5); color: var(--text-primary); text-underline-offset: var(--space-2); }
	.empty-note, .empty-state { margin: var(--space-5) 0 0; }
	.empty-state { padding: var(--space-6); border: var(--border-width-default) solid var(--border-subtle); border-radius: var(--shape-radius-sm); background: var(--surface-muted); }
	.unranked-details { margin-top: var(--space-6); }
	summary { display: inline-flex; min-height: var(--touch-target-min); align-items: center; cursor: pointer; font-weight: var(--font-weight-semibold); }
	.unranked-row { display: grid; gap: var(--space-3); padding-top: var(--space-5); border-top: var(--border-width-default) solid var(--border-subtle); }
	.unranked-row .quick-evidence { margin-top: 0; }
	summary:focus-visible, a:focus-visible { outline: var(--focus-outline-width) solid var(--focus-ring); outline-offset: var(--focus-outline-offset-sm); }
	@media (min-width: 68.75rem) { .page-section { margin-top: var(--layout-section-gap); } .model-row { grid-template-columns: 7rem minmax(0, 1fr); } }
</style>
